{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/index.ts",
        "src/contentScript/tableWidgetExtension.ts",
        "src/**/*.test.ts",
        "scripts/*.test.mjs"
    ],
    "project": [
        "src/**/*.ts",
        "scripts/*.mjs"
    ],
    "ignoreIssues": {
        "api/**": [
            "unlisted",
            "unresolved"
        ]
    },
    "tags": [
        "-lintignore"
    ]
}
