{
    "compilerOptions": {
        "outDir": "./dist/",
        "module": "commonjs",
        "target": "es2020",
        "jsx": "react",
        "allowJs": true,
        "baseUrl": ".",
        "esModuleInterop": true,
        "types": ["node", "jest"],
        "ignoreDeprecations": "6.0"
