{
    "$schema": "./node_modules/fallow/schema.json",
    "entry": ["src/index.ts", "src/contentScript/tableWidgetExtension.ts"],
    "supportEntry": ["src/**/*.test.ts"],
    "ignorePatterns": ["**/*.d.ts", "api/**"],
    "rules": {
        "complexity-crap": "off",
        "dev-dependencies-in-production": "off",
        "test-only-exports": "warn",
        "require-suppression-reason": "error"
    },
    "health": {
        "maxCognitive": 15,
        "maxCyclomatic": 20
    },
    "boundaries": {
        "zones": [
            { "name": "shared", "patterns": ["src/contentScript/shared/**"] },
            { "name": "services", "patterns": ["src/contentScript/services/**"] },
            { "name": "tableModel", "patterns": ["src/contentScript/tableModel/**"] },
            { "name": "tableState", "patterns": ["src/contentScript/tableState/**"] },
            { "name": "nestedEditor", "patterns": ["src/contentScript/nestedEditor/**"] },
            { "name": "tableWidget", "patterns": ["src/contentScript/tableWidget/**"] },
            { "name": "tableRuntimeLifecycle", "patterns": ["src/contentScript/tableRuntime/lifecycle/**"] },
            {
                "name": "tableRuntimeEntryPoints",
                "patterns": [
                    "src/contentScript/tableRuntime/operations/structuralActions.ts",
                    "src/contentScript/tableRuntime/operations/insertTable.ts",
                    "src/contentScript/tableRuntime/operations/sourceModeController.ts"
                ]
            },
            { "name": "tableRuntime", "patterns": ["src/contentScript/tableRuntime/**"] },
            { "name": "toolbar", "patterns": ["src/contentScript/toolbar/**"] },
            { "name": "tableCommands", "patterns": ["src/contentScript/tableCommands/**"] }
        ],
        "rules": [
            { "from": "shared", "allow": [] },
            { "from": "services", "allow": ["shared"] },
            { "from": "tableModel", "allow": ["shared"] },
            { "from": "tableState", "allow": ["shared", "tableModel"] },
            { "from": "nestedEditor", "allow": ["shared", "services", "tableModel", "tableState"] },
            {
                "from": "tableWidget",
                "allow": ["shared", "services", "tableModel", "tableState", "nestedEditor"]
            },
            {
                "from": "tableRuntime",
                "allow": [
                    "shared",
                    "services",
                    "tableModel",
                    "tableState",
                    "tableWidget",
                    "nestedEditor",
                    "tableRuntimeEntryPoints"
                ]
            },
            {
                "from": "tableRuntimeEntryPoints",
                "allow": [
                    "shared",
                    "services",
                    "tableModel",
                    "tableState",
                    "tableWidget",
                    "nestedEditor",
                    "tableRuntime"
                ]
            },
            {
                "from": "tableRuntimeLifecycle",
                "allow": [
                    "shared",
                    "services",
                    "tableModel",
                    "tableState",
                    "tableWidget",
                    "nestedEditor",
                    "tableRuntime",
                    "tableRuntimeEntryPoints"
                ]
            },
            {
                "from": "toolbar",
                "allow": ["shared", "services", "tableState", "tableWidget", "tableRuntimeEntryPoints"]
            },
            {
                "from": "tableCommands",
                "allow": ["shared", "tableState", "tableRuntimeEntryPoints"]
            }
        ]
    }
}
