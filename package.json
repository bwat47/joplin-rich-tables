{
    "name": "joplin-plugin-rich-tables",
    "version": "1.14.2",
    "scripts": {
        "dist": "npm run typecheck && node scripts/build.mjs",
        "prepare": "npm run dist",
        "updateVersion": "node scripts/updateVersion.mjs",
        "lint": "eslint src/ scripts/",
        "lint:fix": "eslint src/ scripts/ --fix",
        "format": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\"",
        "bench:table-parsing": "vitest bench src/contentScript/__benchmarks__/tableParsing.bench.ts --run",
        "test": "vitest run --passWithNoTests && node --test scripts/*.test.mjs",
        "test:watch": "vitest --passWithNoTests",
        "knip": "knip",
        "typecheck": "tsc --noEmit",
        "updateApi": "node scripts/updateApi.mjs"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "dependencies": {
        "@codemirror/autocomplete": "6.20.1",
        "@codemirror/commands": "6.10.3",
        "@codemirror/lang-markdown": "6.5.0",
        "@codemirror/language": "6.12.3",
        "@codemirror/search": "6.6.0",
        "@codemirror/state": "6.7.1",
        "@codemirror/view": "6.43.14",
        "@floating-ui/dom": "^1.8.0",
        "@joplin/fork-uslug": "^2.0.6",
        "@lezer/common": "1.5.0",
        "@lezer/highlight": "1.2.3",
        "@lezer/markdown": "1.6.3",
        "dompurify": "^3.4.17"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^25.9.4",
        "@vitest/coverage-v8": "^5.1.0",
        "@vitest/eslint-plugin": "^1.6.28",
        "esbuild": "^0.28.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-tsdoc": "^0.5.4",
        "globals": "^17.7.0",
        "jsdom": "^31.0.0",
        "knip": "^6.44.1",
        "prettier": "^3.9.10",
        "tar": "^7.5.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "^5.1.0"
    },
    "overrides": {
        "eslint-plugin-tsdoc": {
            "@typescript-eslint/utils": "8.72.1"
        }
    }
}
