{
    "name": "joplin-plugin-rich-tables",
    "version": "1.14.2",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "lint": "oxlint src/ && npm run lint:boundaries && npm run lint:complexity",
        "lint:boundaries": "fallow dead-code --boundary-violations",
        "lint:complexity": "fallow health --complexity",
        "lint:fix": "oxlint src/ --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "bench:table-parsing": "vitest bench src/contentScript/__benchmarks__/tableParsing.bench.ts --run",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest --passWithNoTests",
        "knip": "knip",
        "typecheck": "tsc --noEmit",
        "updateApi": "joplin-plugin-scripts update-api"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "@joplin/fork-uslug": "^2.0.6",
        "dompurify": "^3.4.17"
    },
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.6.0",
        "@codemirror/autocomplete": "6.20.1",
        "@codemirror/commands": "6.10.3",
        "@codemirror/lang-markdown": "6.5.0",
        "@codemirror/language": "6.12.3",
        "@codemirror/search": "6.6.0",
        "@codemirror/state": "6.7.1",
        "@codemirror/view": "6.43.14",
        "@lezer/common": "1.5.0",
        "@lezer/highlight": "1.2.3",
        "@lezer/markdown": "1.6.3",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint-plugin-regexp": "^3.3.3",
        "fallow": "^3.43.0",
        "jsdom": "^31.0.0",
        "knip": "^6.44.1",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
